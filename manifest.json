{
  "manifest_version": 3,
  "name": "GitHub Milestone Groups",
  "description": "Lets you group issues in a GitHub milestone.",
  "version": "1.0.0",
  "action": { "default_popup": "index.html" },
  "content_scripts": [
    {
      "js": ["src/content.tsx"],
      "matches": ["https://github.com/*/*/milestone/*"]
    }
  ]
}
